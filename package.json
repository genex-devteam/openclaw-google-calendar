{
  "name": "@genex-devteam/openclaw-google-calendar",
  "version": "0.1.0",
  "description": "Google Calendar plugin for OpenClaw",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "package": "npm run plugin:build"
  },
  "dependencies": {
    "googleapis": "^150.0.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openclaw": "2026.9.6",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ]
}
